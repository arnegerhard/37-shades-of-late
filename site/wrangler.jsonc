{
  "$schema": "../proxy/node_modules/wrangler/config-schema.json",
  // Marketing page for 37shadesoflate.com, and the page shared stops link to. Build with ./build.sh, deploy with
  // `npx wrangler deploy` (run from proxy/ node_modules or with npx).
  "name": "37shadesoflate-site",
  "compatibility_date": "2026-09-01",
  // Static files, but /s (a shared stop) goes through src/worker.ts for its link preview, and
  // /s/card.png draws its picture.
  "main": "src/worker.ts",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/s", "/s/card.png", "/mapkit-token", "/stats", "/stats/*"] },
  // The card's fonts and the stats page's pictures of the app, as bytes (src/card.ts, src/screens.ts); the
  // stats page, as text (src/stats.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.ttf", "**/*.jpg"] }, { "type": "Text", "globs": ["**/*.html"] }],
  // The app's journeys, which the proxy stores (its migrations/ has the table), for the stats page.
  "d1_databases": [{ "binding": "JOURNEYS", "database_name": "bus37-journeys", "database_id": "4c9f7b02-981d-4722-bb4d-1b980ff44b00" }],
  // Keep the original workers.dev address serving too; custom domains turn it off by default.
  "workers_dev": true,
  "preview_urls": false,
  // Custom domains: Cloudflare creates the DNS records and certificates for these.
  "routes": [
    { "pattern": "37shadesoflate.com", "custom_domain": true },
    { "pattern": "www.37shadesoflate.com", "custom_domain": true }
  ]
}
