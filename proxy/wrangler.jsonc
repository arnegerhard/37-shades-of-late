{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bus37-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "CACHE", "class_name": "TransitCache" },
      // The Live Activities being kept current with pushes (src/activities.ts).
      { "name": "ACTIVITIES", "class_name": "LiveActivities" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TransitCache"] },
    { "tag": "v2", "new_sqlite_classes": ["LiveActivities"] }
  ],
  // Anonymous usage events (see recordUsage in src/index.ts); query with the Analytics Engine SQL API.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS_ENGINE", "dataset": "37ShadesOfLate" }],
  "vars": {
    // 511.org's default token limit is 60 requests/hour; keep a little headroom.
    "HOURLY_BUDGET": "55",
    // One all-stops 511 call per refresh: 70s is ~51 calls/hour, leaving room for line/stop lists.
    "SNAPSHOT_TTL_SECONDS": "70",
    "STATIC_TTL_SECONDS": "86400"
  }
  // Secrets (set with `wrangler secret put …`): API_KEY_511, OBA_API_KEY, MTA_BUSTIME_KEY, and APNS_KEY
  // (the APNs auth key's .p8) with APNS_KEY_ID, for Live Activity pushes.
}
